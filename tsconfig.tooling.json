{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "Preserve",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "types": ["node"], "esModuleInterop": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "server/types/**/*.d.ts", "drizzle.config.ts", "vitest.config.ts"]
}
