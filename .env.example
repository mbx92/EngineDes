# Separate app and migration credentials; never use a superuser for DATABASE_URL.
DATABASE_URL=postgres://enginedes_app:CHANGE_ME@localhost:5432/enginedes
MIGRATION_DATABASE_URL=postgres://enginedes_migrator:CHANGE_ME@localhost:5432/enginedes
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
LOG_LEVEL=info
