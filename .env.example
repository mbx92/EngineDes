# Separate app and migration credentials; never use a superuser for DATABASE_URL.
DATABASE_URL=postgres://enginedes_app:CHANGE_ME@localhost:5432/enginedes
MIGRATION_DATABASE_URL=postgres://enginedes_migrator:CHANGE_ME@localhost:5432/enginedes
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional exact origins for LAN access, comma-separated (no trailing slash).
BETTER_AUTH_TRUSTED_ORIGINS=
LOG_LEVEL=info

# Initial admin bootstrap for an empty installation [MBX-5][ORG-001][IAM-001][AUDIT-001].
# Fill these in local .env only; password must be 12–128 characters.
# Remove bootstrap credentials from local .env after successful bootstrap.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
BOOTSTRAP_BUMDES=

# Account activation email (provider-independent SMTP; configure before sending invitations).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional explicit tenant for local DEMO seed [MBX-5][ORG-001].
SEED_TENANT_ID=
