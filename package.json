    "pino": "10.3.1",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nuxt/test-utils": "4.3.2",
    "@types/node": "22.20.4",
    "drizzle-kit": "0.31.11",
    "happy-dom": "20.14.5",
